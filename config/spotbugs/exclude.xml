<FindBugsFilter>
    <!-- Add exclusions only after an ADR: first try to fix the code -->
    <!-- Example: ignore Lombok-generated code -->
    <!--
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
        <Class name="~.*\.BasedevApplication"/>
    </Match>
    -->
    <!-- SimpleCase is a load-once value holder: record components are wrapped in
         List.copyOf() by the compact constructor, so accessors cannot expose
         mutable state. The remaining EI_EXPOSE_REP/EI_EXPOSE_REP2 findings are
         static-analysis noise (unmodifiable wrapping is not tracked). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="ru.anseranser.config.CaseConfig$SimpleCase"/>
    </Match>
</FindBugsFilter>